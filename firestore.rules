rules_version = '2';

// Data model reference: ARCHITECTURE.md §6.
// Single-author-per-Story model: every /stories/{storyId} doc has an
// ownerUid; every subcollection under it (elements, messages, versions,
// conflicts, outstanding_questions, and the analogous Project 2-4
// subcollections) inherits that same ownership check.

service cloud.firestore {
  match /databases/{database}/documents {

    match /stories/{storyId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
