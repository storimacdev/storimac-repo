ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed for local dev against real Firestore/Storage (not the emulator).
# On Cloud Run / Firebase App Hosting, the attached service account is used
# instead and neither of these should be set. Paste the full contents of a
# downloaded service-account JSON key as a single-line string for the first one.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Client-side Firebase config (issue #88 — Auth). These are PUBLIC values by
# design (Firebase security comes from Security Rules, not from hiding this
# key) — safe to commit as an example and to ship in the client bundle.
# Get real values with: firebase apps:sdkconfig web <appId> --project storimac
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=storimac.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=storimac
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=storimac.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=84713589523
NEXT_PUBLIC_FIREBASE_APP_ID=1:84713589523:web:218bfc27c7687dffac28e6

# Set to connect the client SDK to the local Auth/Firestore emulators
# instead of production Firebase (see README "Run it locally" for the
# matching emulator startup command).
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
